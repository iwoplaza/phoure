{
  "name": "phoure",
  "version": "0.0.0",
  "type": "module",
  "description": "Ethical AI upscaling for games.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module": "./dist/index.js",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["README.md", "package.json", "dist"],
  "scripts": {
    "build": "rollup -c",
    "dev:build": "rollup -c",
    "dev:watch": "rollup -c --watch"
