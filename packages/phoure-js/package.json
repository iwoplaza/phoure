  "keywords": ["ai", "upscaling", "games", "webgpu", "typegpu"],
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@webgpu/types": "^0.1.34",
    "rollup": "^4.29.1",
    "rollup-plugin-typegpu": "^0.0.1",
    "typegpu": "https://pkg.csb.dev/software-mansion/TypeGPU/commit/e87b5a34/typegpu"
  },
  "peerDependencies": {
    "@typegpu/color": "^0.0.0",
    "@typegpu/common": "^0.0.0",
    "typegpu": "^0.3.0"
  }
}
