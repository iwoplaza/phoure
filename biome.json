{
  "$schema": "https://biomejs.dev/schemas/1.8.3/schema.json",
  "organizeImports": {
    "enabled": true
  },
  "files": {
    "ignore": ["**/dist/*", "**/*.d.ts"]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": { "noUnusedImports": "error" }
    }
  },
  "json": {
    "formatter": {
      "enabled": false,
      "indentStyle": "space"
    }
  },
  "javascript": {
    "formatter": {
      "enabled": false,
      "indentStyle": "space",
      "quoteStyle": "single"
    }
  }
}
