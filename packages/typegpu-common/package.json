{
  "name": "@typegpu/common",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "description": "Common utilities for TypeGPU.",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "README.md",
    "package.json",
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "test:types": "pnpm tsc --p ./tsconfig.json --noEmit",
    "prepack": "pnpm run build"
  },
  "keywords": [],
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "rollup": "^4.29.1",
    "unplugin-typegpu": "catalog:",
    "typegpu": "catalog:",
    "typescript": "npm:tsover@5.9.13"
  },
  "peerDependencies": {
    "typegpu": "^0.12.4"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "module": "./dist/index.js",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    }
  }
}
