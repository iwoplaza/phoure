{
  "name": "@typegpu/color",
  "version": "0.0.0",
  "type": "module",
  "description": "Color utilities for TypeGPU",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module": "./dist/index.js",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "README.md",
    "package.json",
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev:build": "rollup -c",
    "dev:watch": "rollup -c --watch",
    "test:types": "pnpm tsc --p ./tsconfig.json"
  },
  "keywords": [
    "typegpu",
    "color",
    "webgpu",
    "gpu",
    "graphics",
    "gpgpu"
  ],
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "rollup": "^4.29.1",
    "unplugin-typegpu": "catalog:",
    "typegpu": "catalog:"
  },
  "peerDependencies": {
    "typegpu": "^0.3.0"
  }
}
